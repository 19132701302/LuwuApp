<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 我的页菜单行 -->
    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:background">@color/surface</item>
    </style>

    <!-- 顶部工具条 -->
    <style name="ToolbarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 返回按钮 -->
    <style name="BackButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <color name="ic_launcher_background">#0D9488</color>
    <style name="NavTextSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <!-- 底部导航：透明选中指示器（去掉点击/选中时的光圈胶囊背景，商业 App 常见做法） -->
    <style name="NavNoActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
