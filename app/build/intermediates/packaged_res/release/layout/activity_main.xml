<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/line" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@color/surface"
            android:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/NavNoActiveIndicator"
            app:itemBackground="@android:color/transparent"
            app:itemIconTint="@color/nav_color"
            app:itemRippleColor="@android:color/transparent"
            app:itemTextColor="@color/nav_color"
            app:itemTextAppearanceActive="@style/NavTextSmall"
            app:itemTextAppearanceInactive="@style/NavTextSmall"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>

    <!-- 中间发帖按钮：独立于 BottomNavigationView 渲染，避免 itemIconTint 染色导致图标变圆 -->
    <ImageView
        android:id="@+id/btn_publish_fab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:contentDescription="@string/publish"
        android:elevation="6dp"
        android:src="@drawable/ic_publish_round" />
</FrameLayout>
