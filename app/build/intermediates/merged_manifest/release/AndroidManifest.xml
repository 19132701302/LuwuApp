<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.luwu.app"
    android:versionCode="74"
    android:versionName="9.4.8" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 长按保存详情页图片到相册（Android 9 及以下需要；10+ 走 MediaStore 无需权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <permission
        android:name="com.luwu.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.luwu.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.luwu.app.App"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuWu"
        android:usesCleartextTraffic="false" >
        <activity
            android:name="com.luwu.app.ui.SplashAdActivity"
            android:exported="true"
            android:theme="@style/Theme.LuWu" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.luwu.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.luwu.app.ui.ArticleDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.CategoryPostsActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.luwu.app.ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.luwu.app.ui.CommentsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.luwu.app.ui.PublishActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.luwu.app.ui.FavoritesActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.HistoryActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.MyPostsActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.AboutActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.PrivacyActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.FollowListActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.UserProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.NotifyActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.FeedbackActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.BusinessCoopActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.WebPageActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.PayWebViewActivity"
            android:exported="false" />
        <activity
            android:name="com.luwu.app.ui.OrderActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.luwu.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.luwu.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>