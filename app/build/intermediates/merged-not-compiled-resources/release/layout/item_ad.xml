<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_ad_round"
    android:clickable="true"
    android:focusable="true">

    <!-- 全宽广告图（16:9 裁切，商业级卡片） -->
    <ImageView
        android:id="@+id/iv_ad_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/ad_label"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 无图广告（文字兜底）：保持可读 -->
    <TextView
        android:id="@+id/tv_ad_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="14dp"
        android:paddingVertical="18dp"
        android:text=""
        android:textColor="@color/brand_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 视频播放标记 -->
    <LinearLayout
        android:id="@+id/ll_ad_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_play_round"
            android:contentDescription="@string/ad_label"
            android:padding="8dp"
            android:src="@drawable/ic_play" />
    </LinearLayout>

    <!-- 广告标识：图片右上角角标（合规必标） -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_badge_ad"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        android:text="@string/ad_label"
        android:textColor="@color/white"
        android:textSize="10sp" />
</FrameLayout>
