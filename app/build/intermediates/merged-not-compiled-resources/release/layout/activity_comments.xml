<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_bar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/BackButton"
            android:contentDescription="返回"
            android:src="@drawable/ic_back"
            app:tint="@color/ink_2" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/ToolbarTitle"
            android:text="评论" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="还没有评论，来抢沙发～"
        android:textColor="@color/ink_3"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@color/surface"
        android:padding="6dp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reply_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/brand_blue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_cancel_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="取消"
            android:textColor="@color/ink_3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btn_emoji"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="😊"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_img"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="🖼️"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_gray"
            android:hint="说点什么…"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="500"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_3"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="发送"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
