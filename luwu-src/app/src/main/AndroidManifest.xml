<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 长按保存详情页图片到相册（Android 9 及以下需要；10+ 走 MediaStore 无需权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuWu"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.SplashAdActivity"
            android:exported="true"
            android:theme="@style/Theme.LuWu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ui.ArticleDetailActivity" android:exported="false" />
        <activity android:name=".ui.CategoryPostsActivity" android:exported="false" />
        <activity android:name=".ui.SearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.CommentsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PublishActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.FavoritesActivity" android:exported="false" />
        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.MyPostsActivity" android:exported="false" />
        <activity android:name=".ui.AboutActivity" android:exported="false" />
        <activity android:name=".ui.PrivacyActivity" android:exported="false" />
        <activity android:name=".ui.FollowListActivity" android:exported="false" />
        <activity android:name=".ui.UserProfileActivity" android:exported="false" />
        <activity android:name=".ui.NotifyActivity" android:exported="false" />
        <activity android:name=".ui.FeedbackActivity" android:exported="false" />
        <activity android:name=".ui.BusinessCoopActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.WebPageActivity" android:exported="false" />
        <activity android:name=".ui.PayWebViewActivity" android:exported="false" />
        <activity android:name=".ui.OrderActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.luwu.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
