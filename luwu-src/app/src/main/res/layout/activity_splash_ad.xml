<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <ImageView
        android:id="@+id/iv_splash_ad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="开屏广告" />

    <!-- 品牌加载层：冷启动立即渲染（本地资源，零网络），广告图就绪后隐藏 -->
    <LinearLayout
        android:id="@+id/splash_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_splash_logo"
            android:gravity="center"
            android:text="陆"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_tagline"
            android:textColor="@color/ink_3"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/loading"
            android:textColor="@color/ink_3"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 广告标识：合规必标，显著清晰（左上角） -->
    <TextView
        android:id="@+id/tv_ad_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_splash_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/ad_label"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 右上角胶囊：倒计时 + 跳过 合体（主流惯例）；minHeight≥36dp 满足规范，周边留出隐形安全区 -->
    <TextView
        android:id="@+id/btn_splash_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_splash_btn"
        android:minWidth="86dp"
        android:minHeight="36dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:text="跳过"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 底部品牌区：渐变遮罩 + 名称 + 标语（全屏/半屏通用商业样式） -->
    <LinearLayout
        android:id="@+id/splash_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_splash_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="26dp"
        android:paddingBottom="30dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_tagline"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- CTA 限定点击区域：仅此处可点击跳转（合规），无跳转链接时不显示 -->
    <TextView
        android:id="@+id/btn_splash_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="116dp"
        android:background="@drawable/bg_splash_btn"
        android:minHeight="40dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="@string/splash_cta"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
