<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- 顶部搜索栏（商业级：白色导航区 + 浅灰圆角胶囊输入框 + 品牌色文字按钮） -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/BackButton"
            android:contentDescription="返回"
            android:src="@drawable/ic_back"
            app:tint="@color/ink_2" />

        <EditText
            android:id="@+id/et_keyword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="7dp"
            android:drawableTint="@color/ink_3"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_3"
            android:textSize="14sp" />

        <!-- 一键清空输入（输入非空时显示） -->
        <ImageView
            android:id="@+id/btn_clear_keyword"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:contentDescription="清空输入"
            android:gravity="center"
            android:padding="10dp"
            android:src="@drawable/ic_clear_keyword"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="搜索"
            android:textColor="@color/brand_blue"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 搜索范围：iOS 风格分段控件（浅灰胶囊容器 + 选中块品牌渐变） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_title"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_sort_on"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="标题"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_content"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_segment_item_off"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="内容"
            android:textColor="@color/ink_2"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 热门搜索：流式标签云 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="22dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_hot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="热门搜索"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大家都在搜"
            android:textColor="@color/ink_3"
            android:textSize="11.5sp" />
    </LinearLayout>

    <com.luwu.app.ui.FlowLayout
        android:id="@+id/hot_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp" />

    <!-- 搜索历史：标题行 + 右侧清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕘"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="搜索历史"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:text="🗑 清空"
            android:textColor="@color/ink_3"
            android:textSize="12sp" />
    </LinearLayout>

    <com.luwu.app.ui.FlowLayout
        android:id="@+id/history_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp" />

    <!-- 历史空态提示 -->
    <TextView
        android:id="@+id/tv_history_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="暂无搜索记录"
        android:textColor="@color/ink_3"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <!-- 搜索结果空态 -->
    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.55"
            android:contentDescription="无搜索结果"
            android:src="@drawable/ic_empty_box" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="没有找到相关文章"
            android:textColor="@color/ink_2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="换个关键词试试，或改为搜索内容"
            android:textColor="@color/ink_3"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
