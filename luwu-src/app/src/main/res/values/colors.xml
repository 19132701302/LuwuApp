<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== v9.4 商业级设计令牌 ==========
         设计语言：收敛 AI 亮青，回归「深青墨 + 中性灰阶」的现代中文商业 App 视觉
         主色仅用于关键操作与选中态，界面主体由中性色构成 -->

    <!-- 品牌色：深青墨（沉稳，克制，降低模板感） -->
    <color name="brand">#0F766E</color>
    <color name="brand_active">#14B8A6</color>
    <color name="brand_deep">#115E59</color>
    <color name="brand_pressed">#0C645D</color>
    <color name="brand_soft">#E4F2F0</color>
    <color name="brand_ink">#134E4A</color>

    <!-- 兼容旧引用名（色值已收敛） -->
    <color name="brand_blue">#0F766E</color>
    <color name="brand_red">#D92D20</color>
    <color name="brand_dark">#115E59</color>

    <!-- 底色与表面 -->
    <color name="bg_page">#F7F7F8</color>
    <color name="page_bg">#F7F7F8</color>
    <color name="bg_app">#F7F7F8</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#F2F3F5</color>
    <color name="line">#EDEEF0</color>
    <color name="line_strong">#E2E4E7</color>
    <color name="line_soft">#F0F1F3</color>

    <!-- 文字层级（近黑 → 三级灰） -->
    <color name="ink">#111214</color>
    <color name="ink_2">#5C6166</color>
    <color name="ink_3">#9CA1A8</color>
    <color name="ink_4">#C2C6CC</color>

    <!-- 语义色 -->
    <color name="danger">#D92D20</color>
    <color name="success">#12B76A</color>
    <color name="warning">#F79009</color>
    <color name="info">#175CD3</color>

    <!-- 功能色兼容 -->
    <color name="white">#FFFFFF</color>
    <color name="ad_bg">#F4FAF9</color>

    <!-- 底部导航 -->
    <color name="nav_selected">#0F766E</color>
    <color name="nav_unselected">#9CA1A8</color>

    <!-- 卡片/徽标/标签 -->
    <color name="card_shadow">#120F766E</color>
    <color name="tab_indicator">#0F766E</color>
    <color name="chip_bg">#F2F3F5</color>
    <color name="badge_soft_bg">#E4F2F0</color>
    <color name="badge_soft_text">#0F766E</color>
    <color name="bg_neutral_soft">#F2F3F5</color>
    <color name="dot_off">#D9DCE1</color>

    <!-- 分类图标柔和色系（替代 8 色高饱和：仅 4 个低饱和家族，识别度靠深浅而非花哨） -->
    <color name="cat_a_bg">#E4F2F0</color>
    <color name="cat_a_fg">#0F766E</color>
    <color name="cat_b_bg">#E9F0FA</color>
    <color name="cat_b_fg">#3B5FBF</color>
    <color name="cat_c_bg">#F4EEE4</color>
    <color name="cat_c_fg">#A4622A</color>
    <color name="cat_d_bg">#F2EAF3</color>
    <color name="cat_d_fg">#7A4A8C</color>
</resources>
