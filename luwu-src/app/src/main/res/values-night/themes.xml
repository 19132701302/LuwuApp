<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v9.4 深色主题：与亮色同名属性覆盖（系统栏反相） -->
    <style name="Theme.LuWu" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_ink</item>
        <item name="colorSecondary">@color/brand_active</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_ink</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_alt</item>
        <item name="colorSurfaceContainerLow">@color/bg_page</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:colorControlHighlight">@color/line_strong</item>

        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/bg_page</item>

        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorTertiary">@color/ink_3</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:textColorLink">@color/brand</item>

        <item name="android:listDivider">@color/line</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:overScrollMode">never</item>
    </style>
</resources>
